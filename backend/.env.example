# Copy to .env (gitignored) and fill in what you use.

# ---------------------------------------------------------------------------
# API keys — set the one(s) matching the providers you select below.
# The key is looked up by provider, not by which model is "default": if
# RECENTER_MODEL is an openai:* spec, OPENAI_API_KEY must be set.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Models (REC-25) — "provider:model" strings resolved by app/agent/llm.py via
# LangChain's init_chat_model. Any provider LangChain supports works, as long
# as its integration package is installed; langchain-anthropic and
# langchain-openai ship in requirements.txt.
#
#   RECENTER_MODEL        = responder — writes planner/coach replies
#   RECENTER_ROUTER_MODEL = router — small/fast, picks the subgraph
#
# Both are optional. Unset, they fall back to the defaults marked below.
# A bare model name without a provider prefix also works ("claude-sonnet-4-5");
# init_chat_model infers the provider from the name.
#
# Anthropic (defaults):
# RECENTER_MODEL=anthropic:claude-sonnet-4-5
# RECENTER_ROUTER_MODEL=anthropic:claude-haiku-4-5
#
# OpenAI — requires OPENAI_API_KEY above:
# RECENTER_MODEL=openai:gpt-4o
# RECENTER_ROUTER_MODEL=openai:gpt-4o-mini
#
# Switching provider is an edit here plus that provider's key. No code change:
# no node imports a provider class.
# ---------------------------------------------------------------------------

# LangGraph checkpointer DB (conversation memory per thread_id).
# Kept separate from recenter.db.
# RECENTER_CHECKPOINT_DB=checkpoints.db

# Optional: LangSmith tracing while learning LangGraph (dev observability only)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=recenter
